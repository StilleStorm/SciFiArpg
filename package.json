{
  "name": "zgloszenie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:rules": "node scripts/lint-rules.mjs",
    "check": "npm run typecheck && npm test && npm run lint:rules && npm run build",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs",
    "new-hero": "node scripts/new-hero.mjs",
    "shot": "vite build --outDir ${SHOT_OUT:-dist} && node scripts/shot.mjs",
    "smoke": "vite build && node scripts/smoke.mjs",
    "render-audio": "vite build --outDir ${AUDIO_OUT:-dist} && node scripts/render-audio.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
